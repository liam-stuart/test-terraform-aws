{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "My schema",
    "description": "Schema validation for POST endpoint",
    "type": "object",
    "properties": {
        "name": {
            "description": "Name in submission",
            "type": "string",
            "pattern": "^[A-Za-z]+$"
        },
        "age": {
            "description": "Age in submission",
            "type": "integer",
            "minimum": 0
        },
        "height": {
            "description": "Height (cm) in submission",
            "type": "number",
            "minimum": 0
        }
    },
    "required": ["age", "name", "height"],
    "additionalProperties": false
}